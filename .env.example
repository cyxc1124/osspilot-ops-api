# HTTP listen address
HTTP_ADDR=:8001

# Postgres (goose migrate + API). Empty: healthz still works, auth returns 503.
DATABASE_URL=postgres://osspilot:osspilot@127.0.0.1:5432/osspilot_ops?sslmode=disable

JWT_SECRET=change-me-in-development
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional fallbacks when system_settings has no row
# S3_ENDPOINT=
# RGW_ACCESS_KEY=
# RGW_SECRET_KEY=
# DOWNLOAD_CDN_URL=
# PREVIEW_CDN_URL=
# OBJECT_HTTP_DOMAIN=
# OBJECT_HTTPS_DOMAIN=
# OFFICE_URL=
# CEPH_MGMT_API_URL=

